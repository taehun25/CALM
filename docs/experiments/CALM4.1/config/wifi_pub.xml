<?xml version="1.0" encoding="UTF-8"?>
<dds xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
    <profiles>
        <transport_descriptors>
            <transport_descriptor>
                <transport_id>calm_wifi_pub_udp</transport_id>
                <type>UDPv4</type>
                <interfaceWhiteList>
                    <address>192.168.0.2</address>
                </interfaceWhiteList>
            </transport_descriptor>
        </transport_descriptors>

        <participant profile_name="calm_wifi_pub_participant" is_default_profile="true">
            <rtps>
                <useBuiltinTransports>false</useBuiltinTransports>
                <userTransports>
                    <transport_id>calm_wifi_pub_udp</transport_id>
                </userTransports>
            </rtps>
        </participant>

        <publisher profile_name="calm_wifi_pub_writer" is_default_profile="true">
            <qos>
                <data_sharing>
                    <kind>OFF</kind>
                </data_sharing>
            </qos>
            <historyMemoryPolicy>DYNAMIC</historyMemoryPolicy>
        </publisher>
    </profiles>
</dds>
