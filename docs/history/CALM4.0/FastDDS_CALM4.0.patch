+bool StatefulWriter::perform_calm_pacing()
+{
+    std::unique_lock<RecursiveTimedMutex> lock(mp_mutex);
+
+    uint32_t changes_to_resend = 0;
+    bool has_pending_requested_changes = false;
+    for (ReaderProxy* reader : matched_remote_readers_)
+    {
+        if (!reader->calm_pacing_active())
+        {
+            continue;
+        }
+
+        uint64_t repair_released_bytes = 0;
+        uint64_t new_released_bytes = 0;
+        const uint64_t total_budget = reader->calm_total_release_budget_bytes();
+        const uint64_t requested_bytes = reader->calm_requested_bytes();
+        const uint32_t requested_changes = reader->calm_requested_size();
+        uint64_t accepted_bytes = 0;
+        uint64_t rejected_bytes = 0;
+        uint32_t accepted_changes = 0;
+        uint32_t rejected_changes = 0;
+        const char* phase = "pacing_wait";
+        if (reader->calm_can_release_repair())
+        {
+            changes_to_resend += reader->perform_acknack_response_limited(
+                std::min(reader->calm_budget_bytes(), total_budget),
+                [&](ChangeForReader_t& change)
+                {
+                    assert(nullptr != change.getChange());
+                    const uint64_t change_bytes = reader->calm_change_requested_bytes(change);
+                    if (flow_controller_->add_old_sample(this, change.getChange()))
+                    {
+                        ++accepted_changes;
+                        accepted_bytes += change_bytes;
+                    }
+                    else
+                    {
+                        ++rejected_changes;
+                        rejected_bytes += change_bytes;
+                    }
+                },
+                repair_released_bytes);
+            phase = "pacing_repair_release";
+            reader->storm_observe_tnr_release(
+                requested_bytes, requested_changes,
+                accepted_bytes, accepted_changes,
+                rejected_bytes, rejected_changes);
+        }
+        const bool alongside_repair = repair_released_bytes > 0;
+        if (repair_released_bytes < total_budget &&
+                reader->calm_requested_size() == 0 &&
+                reader->calm_can_release_held_new(alongside_repair))
+        {
+            reader->calm_release_held_new(
+                total_budget - repair_released_bytes,
+                [&](ChangeForReader_t& change)
+                {
+                    assert(nullptr != change.getChange());
+                    // A held-new change already lives in WriterHistory. Queue it
+                    // behind the repair batch as deferred historical work so
+                    // FlowQueue's new-before-old preference cannot invert
+                    // CALM's repair-first shared-budget order.
+                    flow_controller_->add_old_sample(this, change.getChange());
+                },
+                new_released_bytes,
+                alongside_repair);
+            phase = alongside_repair ?
+                    "pacing_shared_release" : "pacing_new_release";
+        }
+        const uint64_t released_bytes = repair_released_bytes + new_released_bytes;
+        if (released_bytes > 0)
+        {
+            reader->calm_note_shared_release(released_bytes, repair_released_bytes);
+            reader->calm_log_release(phase, released_bytes);
+        }
+
+        const bool reader_has_pending = reader->calm_has_pacing_work();
+        reader->calm_pacing_active(reader_has_pending);
+        has_pending_requested_changes |= reader_has_pending;
+    }
+
+    lock.unlock();
+    on_resent_data(changes_to_resend);
+    return has_pending_requested_changes;
+}
