+
+uint64_t ReaderProxy::calm_total_release_budget_bytes() const
+{
+    if (!calm_controls_repair())
+    {
+        return calm_.max_batch_bytes;
+    }
+
+    return std::max(
+        calm_.minimum_budget_bytes,
+        std::min(calm_.congestion_window_bytes, calm_.max_batch_bytes));
+}
