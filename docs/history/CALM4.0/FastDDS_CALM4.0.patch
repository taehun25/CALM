+        bool budget_full = false;
+        unsent_fragments_.for_each(
+            [&](FragmentNumber_t fragment)
+            {
+                if (budget_full)
+                {
+                    deferred.add(fragment);
+                    return;
+                }
+                const uint64_t fragment_bytes = calm_fragment_size(fragment);
+                if (fragment_bytes == 0)
+                {
+                    return;
