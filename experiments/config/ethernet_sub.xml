<?xml version="1.0" encoding="UTF-8"?>
<dds xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
    <profiles>
        <transport_descriptors>
            <transport_descriptor>
                <transport_id>calm_ethernet_sub_udp</transport_id>
                <type>UDPv4</type>
                <interfaceWhiteList>
                    <address>192.168.50.2</address>
                </interfaceWhiteList>
            </transport_descriptor>
        </transport_descriptors>

        <participant profile_name="calm_ethernet_sub_participant" is_default_profile="true">
            <rtps>
                <useBuiltinTransports>false</useBuiltinTransports>
                <userTransports>
                    <transport_id>calm_ethernet_sub_udp</transport_id>
                </userTransports>
            </rtps>
        </participant>

        <subscriber profile_name="calm_ethernet_sub_reader" is_default_profile="true">
            <qos>
                <data_sharing>
                    <kind>OFF</kind>
                </data_sharing>
            </qos>
            <historyMemoryPolicy>DYNAMIC</historyMemoryPolicy>
        </subscriber>
    </profiles>
</dds>
